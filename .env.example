# Set HARNESS_DB_PATH in the process environment; .env is a reference only.
HARNESS_DB_PATH=data/harness.sqlite3
# Full Chat Completions URL. Leave empty to build it from OPENAI_BASE_URL.
HARNESS_MODEL_ENDPOINT=
# OpenAI-compatible root, for example https://host/v1. /chat/completions is appended.
# Keys stay empty in this file. Put secrets only in the process environment.
OPENAI_BASE_URL=
HARNESS_MODEL_NAME=
OPENAI_MODEL=
HARNESS_MODEL_KEY=
OPENAI_API_KEY=
HARNESS_INPUT_BUDGET=12000
HARNESS_MODEL_TIMEOUT=90
