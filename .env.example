# Set HARNESS_DB_PATH in the process environment; .env is a reference only.
HARNESS_DB_PATH=data/harness.sqlite3
# A4 uses the full Chat Completions-compatible URL supplied by the provider.
HARNESS_MODEL_ENDPOINT=
HARNESS_MODEL_NAME=
HARNESS_MODEL_KEY=
HARNESS_INPUT_BUDGET=12000
HARNESS_MODEL_TIMEOUT=25
